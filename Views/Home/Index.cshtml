                }
            }
        }

        async function fetchAndApplyUserDetails(userId)
        {
            try
            {
                const response = await fetch(`/Home/UserDetails/${encodeURIComponent(userId)}`);
                if (!response) throw new Error('Failed to fetch user details');
                const userData = await response.json();
                if (displayName) displayName.textContent = userData.userDisplayName || 'Unknown';
                if (displayEmail) displayEmail.textContent = userData.userEmail || 'no-email';
                if (displayTitle) displayTitle.textContent = userData.userTitle || 'Not Available';
                if (managerNameSpan) managerNameSpan.textContent = userData.managerName || 'Not Available';
                if (managerEmailSpan) managerEmailSpan.textContent = userData.managerEmail || 'Not Available';
                if (managerInfoSection) managerInfoSection.style.display = 'block';
            }
            catch (error)
            {
                console.error('Error fetching user details:', error);
                if (displayName) displayName.textContent = '-- Select a direct report --';
                if (displayEmail) displayEmail.textContent = '-- Select a direct report --';
                if (displayTitle) displayTitle.textContent = '-- Select a direct report --';
                if (managerNameSpan) managerNameSpan.textContent = 'Not Available';
                if (managerEmailSpan) managerEmailSpan.textContent = 'Not Available';
                if (managerInfoSection) managerInfoSection.style.display = 'block';
            }
        }

        if (subjectSelfRadio) subjectSelfRadio.addEventListener('change', onSubjectChange);
        if (subjectDirectRadio) subjectDirectRadio.addEventListener('change', onSubjectChange);

        if (directReportSelect)
