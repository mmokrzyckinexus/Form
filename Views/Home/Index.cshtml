        (function()
        {
            const canvas = document.getElementById('signatureCanvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            ctx.strokeStyle = '#000';
            ctx.lineWidth = 2;
            let drawing = false;
            let lastX = 0;
            let lastY = 0;

            function getPos(e)
            {
                const rect = canvas.getBoundingClientRect();
                if (e.touches && e.touches.length > 0)
                {
                    const t = e.touches[0];
                    return { x: t.clientX - rect.left, y: t.clientY - rect.top };
                }
                return { x: e.clientX - rect.left, y: e.clientY - rect.top };
            }

            function start(e)
            {
                e.preventDefault();
                drawing = true;
                const pos = getPos(e);
                lastX = pos.x;
                lastY = pos.y;
            }
            function move(e)
            {
                if (!drawing) return;
                e.preventDefault();
                const pos = getPos(e);
                ctx.beginPath();
                ctx.moveTo(lastX, lastY);
                ctx.lineTo(pos.x, pos.y);
                ctx.stroke();
                lastX = pos.x;
                lastY = pos.y;
            }
            function end()
            {
                drawing = false;
            }

            canvas.addEventListener('mousedown', start);
            canvas.addEventListener('mousemove', move);
            canvas.addEventListener('mouseup', end);
            canvas.addEventListener('mouseout', end);
            canvas.addEventListener('touchstart', start);
            canvas.addEventListener('touchmove', move);
            canvas.addEventListener('touchend', end);

            document.getElementById('clearSignature').addEventListener('click', () => {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                document.getElementById('signatureDataUrl').value = '';
            });

            document.getElementById('saveSignature').addEventListener('click', () => {
                document.getElementById('signatureDataUrl').value = canvas.toDataURL('image/png');
                alert('Signature saved!');
            });
        })();

        function showCurrentUser()
        {
            if (displayName) displayName.textContent = originalName || '';
            if (displayEmail) displayEmail.textContent = originalEmail || '';
            if (displayTitle) displayTitle.textContent = originalTitle || '';
            if (managerNameSpan) managerNameSpan.textContent = originalManagerName || 'Not Available';
            if (managerEmailSpan) managerEmailSpan.textContent = originalManagerEmail || 'Not Available';
            if (managerInfoSection) managerInfoSection.style.display = 'block';
        }

        function clearForDirectReportNoSelection()
        {
            if (displayName) displayName.textContent = '-- Select a direct report --';
            if (displayEmail) displayEmail.textContent = '-- Select a direct report --';
            if (displayTitle) displayTitle.textContent = '-- Select a direct report --';
            if (managerNameSpan) managerNameSpan.textContent = 'Not Available';
            if (managerEmailSpan) managerEmailSpan.textContent = 'Not Available';
            if (managerInfoSection) managerInfoSection.style.display = 'block';
        }

        function onSubjectChange()
        {
            const isSelf = subjectSelfRadio && subjectSelfRadio.checked;
            if (directReportSelect) directReportSelect.disabled = !(isSelf && directReportSelect.options.length > 1);
            if (isSelf)
