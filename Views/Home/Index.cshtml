        window.addQuestion = function(id) {
            if (!id) return;
            let def = null;
            for (const sec of availableQuestions || [])
            {
                def = (sec.Questions || []).find(q => (q.Id && q.Id === id) || (q.Id && q.Id === id));
                if (def) break;
            }
            if (!def) def = availableQuestions.flatMap(question => question.Questions || []).find(q => (q.Id && q.Id === id) || (q.id && q.id === id));
            if (!def) return;

            instanceCounter++;
            const container = document.getElementById('questionsList');
            if (!container) return console.error('questionsList not found');
            
            const wrapper = document.createElement('div');
            wrapper.className = 'mb-3 border rounded p-2 bg-white';
            wrapper.dataset.defId = id;
            wrapper.dataset.instanceId = `instance_${instanceCounter}`;
            
            const questionRecord = {
                instanceId: wrapper.dataset.instanceId,
                label: def.Label ?? def.label ?? 'Question',
                questionId: def.Id ?? def.id,
                target: def.Target ?? def.target,
                type: def.Type ?? def.type,
                sectionId: null
            };
            
            const title = document.createElement('label');
            title.className = 'mb-2';
            title.innerHTML = `<strong class="h6 m-0">${questionRecord.label}</strong>`;
            wrapper.appendChild(title);

            function setTargetValue(value)
            {
                questionRecord.value = value;
                if (def.Target)
                {
                    if (typeof renderPreviewFromAnswers === 'function')
                    {
                        window.answers = window.answers || {};
                        window.answers[def.Target] = value;
                        renderPreviewFromAnswers();
                    }
                }
                updateQuestionsPreview();
            }
            
            const typeVal = (typeof def.Type === 'number') ? def.Type : (def.Type || '').toString().toLowerCase();
            const options = def.Questions || [];

            if (typeVal === 'text' || typeVal === 0)
            {
                const input = document.createElement('input');
                input.type = 'text';
                input.className = 'form-control';
                input.addEventListener('input', e => setTargetValue(e.target.value));
                wrapper.appendChild(input);
                input.placeholder = 'Type answer...';
            }
            else if (typeVal === 'singleselect' || typeVal === 1)
            {
                const select = document.createElement('select');
                select.className = 'form-select';
                select.appendChild(new Option('-- choose --', ''));
                options.forEach(opt => select.appendChild(new Option(opt, opt)));
                select.addEventListener('change', e => setTargetValue(e.target.value));
                wrapper.appendChild(select);
            }
            else if (typeVal === 'multiselect' || typeVal === 2)
            {
                const select = document.createElement('select');
                select.className = 'form-select';
                select.multiple = true;
                options.forEach(opt => select.appendChild(new Option(opt, opt)));
                select.addEventListener('change', () => {
                    const vals = Array.from(select.selectedOptions).map(o => o.value);
                    setTargetValue(vals.join(', '));
                });
                wrapper.appendChild(select);
            }
            else if (typeVal === 'checkbox' || typeVal === 3)
            {
                options.forEach((option, i) => {
                    const checkboxDiv = document.createElement('div');
                    checkboxDiv.className = 'form-check';
                    const cb = document.createElement('input');
                    cb.type = 'checkbox';
                    cb.className = 'form-check-input';
                    cb.id = `checkbox_${instanceCounter}_${i}`;
                    cb.value = option;
                    cb.addEventListener('change', () => {
                        const checkedValues = Array.from(wrapper.querySelectorAll('input[type=checkbox]:checked')).map(c => c.value);
                        questionRecord.values = checkedValues;
                        questionRecord.value = checkedValues.join(', ');
                        updateQuestionsPreview();
                    });
                    
                    const label = document.createElement('label');
                    label.className = 'form-check-label ms-1';
                    label.textContent = option;
                    label.htmlFor = cb.id;
                    checkboxDiv.appendChild(cb);
                    checkboxDiv.appendChild(label);
                    wrapper.appendChild(checkboxDiv);
                });
            }
            else
            {
                const input = document.createElement('input');
                input.type = 'text';
                input.className = 'form-control';
                input.placeholder = 'Type answer...';
                input.addEventListener('input', e => setTargetValue(e.target.value));
                wrapper.appendChild(input);
            }

            /*const removeButton = document.createElement('button');
            removeButton.type = 'button';
            removeButton.className = 'btn btn-sm btn-outline-danger mt-2';
            removeButton.textContent = 'Remove';
            removeButton.addEventListener('click', () => {
                const index = addedQuestions.findIndex(q => q.instanceId === questionRecord.instanceId);
                if (index >= 0) addedQuestions.splice(index, 1);
                wrapper.remove();
                updateQuestionsPreview();
            });
            
            wrapper.appendChild(removeButton);*/

            addedQuestions.push(questionRecord);

            container.appendChild(wrapper);
            updateQuestionsPreview();
        };

        window.addSection = function (sectionName)
        {
            const selection = document.getElementById('sectionSelect');
            let selectedNames = [];

            if (sectionName)
            {
                selectedNames = [sectionName];
            }
            else if (selection)
            {
                selectedNames = Array.from(selection.selectedOptions).map(option => option.value).filter(v => v);
            }

            if (selectedNames.length === 0) return console.warn('No sections selected');

            const container = document.getElementById('questionsList');
            if (!container) return console.error('questionsList container not found');

            selectedNames.forEach(name => {
                console.log("available questions: ", availableQuestions);
                const sectionDef = (availableQuestions || []).find(s => (s.Section === name) || (s.section === name));
                const sectionId = `section_${Date.now()}_${Math.random().toString(36).substr(2, 6)}`;

                const section = document.createElement('div');
                section.className = 'mb-4 border rounded p-3 bg-light';
                section.id = sectionId;

                const header = document.createElement('div');
                header.className = 'd-flex justify-content-between align-items-center mb-2';
                const title = document.createElement('strong');
                title.textContent = sectionDef?.Section ?? name;
                const removeSectionButton = document.createElement('button');
                removeSectionButton.type = 'button';
                removeSectionButton.className = 'btn btn-outline-danger btn-sm';
                removeSectionButton.textContent = 'Remove Section';
                removeSectionButton.addEventListener('click', () => {
                    for (let i = addedQuestions.length - 1; i >= 0; i--) {
                        if (addedQuestions[i].sectionId === sectionId)
                        {
                            addedQuestions.splice(i, 1);
                        }
                    }
                    section.remove();
                    updateQuestionsPreview();
                });
                header.appendChild(title);
                header.appendChild(removeSectionButton);
                section.appendChild(header);

                const listHolder = document.createElement('div');
                listHolder.className = 'section-questions';
                section.appendChild(listHolder);
                
                container.appendChild(section);

                const questionsInSection = sectionDef?.Questions || [];
                questionsInSection.forEach(question => {
                    window.addQuestion(question.Id ?? question.id ?? question.Id);
                    const maybeLast = container.lastElementChild;
                    if (!maybeLast) return;

                    const hasTitle = maybeLast.querySelector('.question-title, strong.h6, .form-label');
                    if (!hasTitle)
                    {
                        const titleEl = document.createElement('div');
                        titleEl.className = 'mb-2 question-title';
                        titleEl.innerHTML = `<strong class="h6 m-0">${question.Label ?? question.label ?? 'Question'}</strong>`;
                        maybeLast.insertBefore(titleEl, maybeLast.firstChild);
                    }

                    listHolder.appendChild(maybeLast);
                    const instanceId = maybeLast.dataset.instanceId;
                    if (instanceId)
                    {
                        const rec = addedQuestions.find(r => r.instanceId === instanceId);
                        if (rec) rec.sectionId = sectionId;
                    }
                });

                updateQuestionsPreview();
            })
        };

        document.querySelectorAll('button[onclick^="addQuestion"]').forEach(button => {
            button.addEventListener('click', (e) => {
                const selection = document.getElementById('questionSelect');
                if (selection) window.addQuestion(selection.value);
            });
        });

