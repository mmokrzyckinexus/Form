@using Microsoft.Graph.Models
@using System.Text.Json
@{
    ViewData["Title"] = "Home Page";
}
@model HomeIndexViewModel

@{
    var directReportsProjection = Model.AzureUser.DirectReports.Select(user => new
    {
        displayname = user.DisplayName,
        userPrincipalName = user.UserPrincipalName
    }) ?? Enumerable.Empty<object>();

    var directReportsJson = JsonSerializer.Serialize(directReportsProjection);
    var currentdirectReportGivenName = Model.AzureUser.User.GivenName ?? "";
    var currentdirectReportSurName = Model.AzureUser.User.Surname ?? "";
    var currentdirectReportEmail = Model.AzureUser.User.UserPrincipalName ?? "";
}

<header class="document-header">
    <h1>FM-2001 Request Form</h1>
    <span>@DateTime.Now.ToString("MMMM d, yyyy")</span>
</header>

<div class="text-center mb-3">
    <span class="badge bg-light border border-success rounded-pill d-inline-flex align-items-center gap-1 py-0" title="@(ViewBag.DatabaseStatus as string ?? "Database status unknown")" aria-label="@(ViewBag.DatabaseStatus as string ?? "Database status unknown")">
        <span class="@(ViewBag.DatabaseStatus.Contains("successful", StringComparison.OrdinalIgnoreCase) ?? false ? "text-success" : "text-danger")" style="font-size: medium; line-height: 1;" aria-hidden="true">
            ●</span>
        <span class="text-black lh-1">@(ViewBag.DatabaseStatus as string ?? "Database status unknown")</span>
    </span>
</div>

<div class="text-center mb-3">
    <h1 class="display-1">Welcome</h1>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="card-title">Questions</h5>
</div>

<!--component type="typeof(Form.Pages.FormBuilder)" render-mode="ServerPrerendered"
           param-DirectReportJason="@directReportsJson"
           param-UserGivenName="@currentdirectReportGivenName"
           param-UserSurname="@currentdirectReportSurName"
           param-UserEmail="@currentdirectReportEmail" /-->

<div class="row g-3" style="height:75vh;">
    <div class="col-md-5" style="overflow:auto;">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Questions</h5>

                <div class="mb-3">
                    <label class="form-label small">Form subject</label>
                    <div class="d-flex gap-3 align-items-center">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="formSubject" id="subjectSelf" value="self" checked>
                            <label class="form-check-label" for="subjectSelf">For me (@currentdirectReportGivenName @currentdirectReportSurName)</label>
                        </div>

                        @if ((Model.AzureUser.DirectReports ?? Enumerable.Empty<User>()).Any())
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="formSubject" id="subjectDirect" value="direct">
                                <label class="form-check-label" for="subjectDirect">For a direct report</label>
                            </div>
                        }
                    </div>

                    @if ((Model.AzureUser.DirectReports ?? Enumerable.Empty<User>()).Any())
                    {
                        <select id="directReportSelect" class="form-select mt-2">
                            <option value="">-- choose direct report --</option>
                            @foreach (var directReport in Model.AzureUser.DirectReports ?? Enumerable.Empty<User>())
                            {
                                var email = directReport.UserPrincipalName ?? "";
                                <option value="@directReport.Id" data-display="@directReport.DisplayName" data-email="@email">@directReport.DisplayName (@(string.IsNullOrEmpty(email) ? "no-email" : email))</option>
                            }
                        </select>
                        <div class="form-text">Selecting a direct report will overwrite preview fields (local, unsaved).</div>
                    }
                    else
                    {
                        <select id="directReportSelect" class="form-select mt-2" disabled>
                            <option value="">-- choose direct report --</option>
                            @foreach (var directReport in Model.AzureUser.DirectReports ?? Enumerable.Empty<User>())
                            {
                                var email = directReport.UserPrincipalName ?? "";
                                <option value="@directReport.Id" data-display="@directReport.DisplayName" data-email="@email">@directReport.DisplayName (@(string.IsNullOrEmpty(email) ? "no-email" : email))</option>
                            }
                        </select>
                    }
                </div>
                <div class="card mb-3">
                    <div class="card-header">
                        <strong>Filled Out by User Requesting or Changing Access</strong>
                    </div>
                    <div class="card-body" style="min-height: 150px;">
                        <div class="row border rounded h-100">
                            <div class="d-flex align-items-center">
                                <span class="me-2"><strong>Name:</strong></span>
                                <span class="flex-grow-1 text-truncate" id="displayName" style="min-width: 0;">@Model.AzureUser.User.DisplayName</span>
                            </div>
                            <div class="col-md-10">
                                <span class="card-text mb-1"><strong>Email:</strong></span>
                                <span class="flex-grow-1 text-truncate" id="displayEmail">@Model.AzureUser.User.UserPrincipalName</span>
                            </div>
                            <div class="col-md-10">
                                <span class="card-text mb-1"><strong>Title:</strong></span>
                                <span class="flex-grow-1 text-truncate" id="displayTitle">@Model.AzureUser.User.JobTitle</span>
                            </div>
                            <div class="col-md-10">
                                <span class="card-text mb-1"><strong>Department:</strong></span>
                                <span class="flex-grow-1 text-truncate" id="displayDepartment">@Model.AzureUser.User.Department</span>
                            </div>
                            <div class="col-md-10">
                                <span class="card-text mb-1"><strong>Primary Work Location:</strong></span>
                                <span class="flex-grow-1 text-truncate" id="displayLocation">@Model.AzureUser.User.OfficeLocation</span>
                            </div>
                            <div class="col-md-10 mt-2">
                                <label class="form-label mb-1"><strong>Signature:</strong></label>
                                <div>
                                    <canvas id="signatureCanvas" class="border" width="400" height="120" style="touch-action: none; max-width:100%;"></canvas>
                                </div>
                                <div class="mt-2">
                                    <button type="button" id="clearSignature" class="btn btn-sm btn-secondary">Clear</button>
                                    <button type="button" id="saveSignature" class="btn btn-sm btn-primary">Save</button>
                                    <span class="form-text ms-2">Click Save to store an image data URL in the hidden field.</span>
                                </div>
                                <input type="hidden" id="signatureDataUrl" name="SignatureDataUrl" />
                            </div>
                            <div class="col-12" id="managerInfoSection" style="display: block;">
                                <hr class="my-2">
                                @if (Model.AzureUser.Manager is User manager)
                                {
                                    <div class="row">
                                        <div class="col-md-12">
                                            <span class="card-text mb-1"><strong>Manager:</strong></span>
                                            <span class="flex-grow-1 text-truncate" id="managerName">@manager.DisplayName</span>
                                        </div>
                                        <div class="col-md-12">
                                            <span class="card-text mb-1"><strong>Manager Email:</strong></span>
                                            <span class="flex-grow-1 text-truncate" id="managerEmail">@manager.UserPrincipalName</span>
                                        </div>
                                    </div>
                                }
                                else if (Model.AzureUser.Manager is OrgContact orgContact)
                                {
                                    <div class="row">
                                        <div class="col-md-6">
                                            <span class="card-text mb-1"><strong>Manager:</strong></span>
                                            <span class="flex-grow-1 text-truncate" id="managerName">@orgContact.DisplayName</span>
                                        </div>
                                        <div class="col-md-6">
                                            <span class="card-text mb-1"><strong>Manager Email:</strong></span>
                                            <span class="flex-grow-1 text-truncate" id="managerEmail">@orgContact.Mail</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <p id="managerNameRow"><strong>Manager:</strong> Not available</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div id="questionsList" class="mb-3">
                    <!-- questions rendered here by JS -->
                </div>

                <div class="mb-3">
                    <!--<label class="form-label">Add a question</label>
                    <select id="questionSelect" class="form-select">
                        <option value="">-- Add a question --</option>
                        @foreach (var question in Model.AvailableQuestions)
                        {
                            <option value="@question.Section">@question.Section</option>
                        }
                    </select>-->

                    <label class="form-label">Choose a section to add</label>
                    <select id="sectionSelect" class="form-select" multiple size="6">
                        @foreach (var question in Model.AvailableQuestions)
                        {
                            <option value="@question.Section">@question.Section</option>
                        }
                    </select>
                    <div class="mt-2">
                        <!--<button type="button" class="btn btn-sm btn-primary" onclick="addSection(document.getElementById('sectionSelect').value)">Add section</button>-->
                        <button type="button" class="btn btn-sm btn-primary" onclick="window.addSection()">Add section</button>
                    </div>
                </div>

                <!--<button type="button" onclick="addQuestion(document.getElementById('questionSelect').value)">Add question</button>

                <div class="form-text mb-2">
                    Each question creates an answer input. Typing an answer will update the mapped preview field in realtime.
                </div>

                <div class="d-flex gap-2">
                    <button id="btnResetQuestions" class="btn btn-secondary">Reset questions</button>
                    <button id="btnClearAnswers" class="btn btn-outline-secondary">Clear answers</button>
                </div>-->
            </div>
        </div>

        <div id="previewWrapper" class="card d-none">
            <div class="card-body">
                <div id="previewQuestions" class="mt-4 d-none" style="background-color: red">
                    <div id="questionsPreviewList"
                         class="border rounded p-2"
                         style="min-height:100px; background-color:black;">
                    </div>
                </div>
            </div>
        </div>
        
        <div id="emptyPlaceholder" class="card text-muted text-center p-5"> </div>
    </div>
</div>

