@using System.Security.Principal
@using Microsoft.Graph.Models

@model HomeIndexViewModel

<ul class="navbar-nav ms-auto">
    @if (User.Identity.IsAuthenticated)
    {
        <a class="nav-link" asp-area="microsoftidentity" asp-controller="account" asp-action="signout">
            <li class="nav-item d-flex align-items-center gap-2 user-profile">

                <img src="@Url.Action("ProfilePhoto", "Home")" alt="Profile Photo" class="profile-photo" aria-hidden="true" onerror="this.style.display='none'" />

                <div class="d-flex flex-column">
                    <h4 class="small fw-bold text-black">@Model.AzureUser.User.DisplayName</h4>
                    sign out
                </div>
            </li>
        </a>
        
        /*<li class="nav-item">
            <small class="text-muted">
                @foreach (var c in User.Claims)
                {
                    <p>@c.Type: @c.Value</p>
                }
            </small>
        </li>*/
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="microsoftidentity" asp-controller="account" asp-action="signin">
                sign in
            </a>
        </li>
    }
</ul>
