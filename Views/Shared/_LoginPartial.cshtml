@using System.Security.Principal
@using Microsoft.Graph.Models

@model HomeIndexViewModel

<ul class="navbar-nav ms-auto">
    @if (User.Identity.IsAuthenticated)
    {
        <li class="nav-item d-flex align-items-center gap-2">
            <img src="@Url.Action("ProfilePhoto", "Home")" alt="Profile Photo" class="profile-photo" aria-hidden="true" onerror="this.style.display='none'"/>
            
            <div class="d-flex flex-column">
                <span class="small fw-bold">@Model.AzureUser.User.DisplayName</span>
                <a class="nav-link text-dark" asp-area="microsoftidentity" asp-controller="account" asp-action="signout">
                    sign out
                </a>
            </div>
        </li>
        /*<li class="nav-item">
            <small class="text-muted">
                @foreach (var c in User.Claims)
                {
                    <p>@c.Type: @c.Value</p>
                }
            </small>
        </li>*/
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="microsoftidentity" asp-controller="account" asp-action="signout">
                sign in
            </a>
        </li>
    }
</ul>
